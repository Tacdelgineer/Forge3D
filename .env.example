# Copy to .env and fill in.  .env is gitignored - never commit real tokens.

# --- Hugging Face ----------------------------------------------------------
# Required. TRELLIS.2 pulls two GATED repos that your account must be granted
# access to before a generation can run:
#   https://huggingface.co/facebook/dinov3-vitl16-pretrain-lvd1689m  (manual approval)
#   https://huggingface.co/briaai/RMBG-2.0                            (instant, accept terms)
# The base weights (microsoft/TRELLIS.2-4B, ~16 GB) are NOT gated.
HF_TOKEN=

# --- Dashboard ---------------------------------------------------------------
# Host address the dashboard binds to.
#   127.0.0.1        loopback only (default; use an SSH tunnel to reach it)
#   <tailscale-ip>   reachable from your other devices over Tailscale  <- recommended
#   0.0.0.0          NOT recommended: docker bypasses ufw, so this exposes the
#                    UI to the entire LAN with no authentication.
FORGE3D_BIND=127.0.0.1

# --- Memory safety ---------------------------------------------------------
# Refuse to load the model or start a generation when MemAvailable is below
# this many GiB. This box shares one 128 GB pool between CPU and GPU, and the
# existing content-factory worker hard-fails its own jobs below 40 GiB, so we
# keep our floor above that. We never unload anyone else's model automatically.
#
# Why 65 and not 45: the check is PRE-FLIGHT only - a generation keeps drawing
# memory after it passes. Measured whole-run peaks (model load + generate +
# export) are ~27 GiB for 512 and ~44 GiB for 1024_cascade; the Step 5
# regression run drew 26.66 GiB and bottomed out at 52.5 GiB MemAvailable.
# Starting at 65 GiB keeps even a 1024_cascade run clear of the floor below.
TRELLIS_MIN_AVAILABLE_GB=65

# Per-mode projected floor. Before a run starts, Forge3D projects the lowest
# MemAvailable it will reach (headroom minus the mode's measured peak) and
# refuses if that would fall below this. 40 matches content-factory's own hard
# VISUAL_MIN_AVAILABLE_GB, so a Forge3D run can never make its jobs fail.
# Lowering it trades content-factory's safety for Forge3D availability.
TRELLIS_PROTECTED_FLOOR_GB=40

# --- Generation defaults ---------------------------------------------------
TRELLIS_MODEL_REPO=microsoft/TRELLIS.2-4B
# One of: 512 | 1024 | 1024_cascade | 1536_cascade  (overridable per request)
#
#   512           "Standard"     ~100 s warm   lower memory   <- Forge3D default
#   1024_cascade  "High Quality" ~200 s        higher memory
#
# Both modes emit the same full PBR output with 4096x4096 base-colour and
# metallic-roughness textures; the difference is geometry resolution, time
# and peak memory - not texture quality.
TRELLIS_PIPELINE_TYPE=512
ATTN_BACKEND=flash_attn

# --- Exclusive / Max Quality (optional) ------------------------------------
# High Quality and Ultra need more memory than this host has free while Ollama
# and the Hunyuan worker hold theirs. Exclusive mode asks a small host helper to
# free the approved workloads for one run and put them back afterwards.
#
#   sudo host/install.sh           install and start the helper
#   sudo forge3d-resctl recover    manual restore, if a run ever left something down
#   sudo host/install.sh --uninstall
#
# The helper is OPTIONAL. Without it the checkbox is shown disabled with the
# reason, and every other behaviour - including the protected floor below - is
# exactly as it was before Step 6.
#
# Measured on this DGX (2026-09-16): freeing Ollama's qwen3.6:35b-a3b and the
# Hunyuan worker's pipelines took MemAvailable from 60.40 to 106.67 GiB.
#
# Directory bind-mounted into the container; it holds ONE Unix socket and gives
# the container no other host access. No Docker socket is mounted, ever.
FORGE3D_RESCTL_DIR=/run/forge3d-resctl
FORGE3D_RESCTL_SOCKET=/run/forge3d-resctl/resctl.sock
#
# Lease length. The helper restores the paused workloads by itself if Forge3D
# stops renewing - a crashed container, a hung app, a killed job - so this is
# the longest anything can stay paused without Forge3D asking for it. Clamped
# by the helper to 60..3600 s. A 1536_cascade run takes minutes, not hours.
FORGE3D_EXCLUSIVE_LEASE_S=1800

# --- Hunyuan3D worker (optional) -------------------------------------------
# The Hunyuan generators run in a SEPARATE container: Hunyuan3D pins
# transformers 4.46 while TRELLIS.2 needs 4.57, so they cannot share an
# environment, and the known-good TRELLIS CUDA stack is left untouched.
# The worker is opt-in and off by default:
#
#   docker compose --profile hunyuan up -d hunyuan
#
# With it stopped, TRELLIS works exactly as before and the Hunyuan generators
# show as unavailable in the UI, with the reason and the command to start them.
HUNYUAN_URL=http://hunyuan:8190
#
# Weights (~24 GiB) are cached on the ./models/hunyuan bind mount and fetched
# on first use - never baked into the image, never committed. These repos are
# NOT gated, so HF_TOKEN is not needed for them; it is still required for
# TRELLIS.2's gated dependencies above.
#
# LICENCE: the Hunyuan3D models are under the Tencent Hunyuan 3D Community
# License, which is NOT an open-source licence. They are not licensed for use
# in the European Union, the United Kingdom or South Korea; a separate licence
# is required above 1 million monthly active users; and an Acceptable Use
# Policy applies. See docs/step-05-multi-model.md before deploying.

# --- Build / runtime -------------------------------------------------------
# Parallel nvcc jobs during the flash-attn build. Keep below the 20 host cores
# so the build does not starve ComfyUI / content-factory.
MAX_JOBS=4
# File ownership on the ./data and ./models bind mounts.
UID=1000
GID=1000
