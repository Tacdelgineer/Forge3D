# Copy to .env. Real tokens and private interface addresses must stay local.
# .env and .env.* are ignored, except this example.

# HF read token; obtain approvals with the SAME account before using TRELLIS:
# https://huggingface.co/facebook/dinov3-vitl16-pretrain-lvd1689m
# https://huggingface.co/briaai/RMBG-2.0
# RMBG's public terms cover non-commercial use; see docs/THIRD_PARTY.md.
# Hunyuan's main weight repositories currently do not require a token.
HF_TOKEN=

# UI/API port is 8189. Keep loopback and use an SSH tunnel for remote access.
# The app has no authentication; Docker-published ports may bypass host firewall.
FORGE3D_BIND=127.0.0.1

# Unified-memory gate: require max(minimum, mode peak + protected floor) GiB.
# Selected-backend reusable residency is credited. This is pre-flight only;
# peaks vary, so leave extra headroom. Normal jobs do not unload other workloads.
TRELLIS_MIN_AVAILABLE_GB=65
TRELLIS_PROTECTED_FLOOR_GB=40

# Per-job UI choices can override the default geometry mode.
# 512 (Standard), 1024_cascade (High Quality), 1536_cascade (experimental Ultra).
# 1024 is also supported by the API. Texture size is independent (default 4096).
TRELLIS_MODEL_REPO=microsoft/TRELLIS.2-4B
TRELLIS_PIPELINE_TYPE=512
ATTN_BACKEND=flash_attn

# Optional Hunyuan worker: docker compose --profile hunyuan up -d hunyuan
# Main weights cache in ./models/hunyuan; Real-ESRGAN is fetched at image build.
# Restricted Tencent community licenses apply; see docs/THIRD_PARTY.md.
HUNYUAN_URL=http://hunyuan:8190

# Optional TRELLIS Exclusive / Max Quality host helper. Configure local service
# endpoints/ownership FIRST; see docs/SETUP.md. It may unload Ollama/Hunyuan models
# and pause the fixed pipeline-worker.service, then restore prior service state
# and pinned Ollama models. Hunyuan reloads lazily. The floor remains unchanged.
# Install: sudo host/install.sh    Recovery: sudo forge3d-resctl recover
FORGE3D_RESCTL_DIR=/run/forge3d-resctl
FORGE3D_RESCTL_SOCKET=/run/forge3d-resctl/resctl.sock
FORGE3D_EXCLUSIVE_LEASE_S=1800

# CUDA compilation parallelism. Lower on a busy host; rebuilding applies it.
MAX_JOBS=4
# Match your host IDs for writable data/model mounts. README shows id -u / id -g.
# Do not source this file in bash: UID is a read-only bash variable.
UID=1000
GID=1000
