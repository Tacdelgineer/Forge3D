# Copy to .env and fill in.  .env is gitignored - never commit real tokens.

# --- Hugging Face ----------------------------------------------------------
# Required. TRELLIS.2 pulls two GATED repos that your account must be granted
# access to before a generation can run:
#   https://huggingface.co/facebook/dinov3-vitl16-pretrain-lvd1689m  (manual approval)
#   https://huggingface.co/briaai/RMBG-2.0                            (instant, accept terms)
# The base weights (microsoft/TRELLIS.2-4B, ~16 GB) are NOT gated.
HF_TOKEN=

# --- Memory safety ---------------------------------------------------------
# Refuse to load the model or start a generation when MemAvailable is below
# this many GiB. This box shares one 128 GB pool between CPU and GPU, and the
# existing content-factory worker hard-fails its own jobs below 40 GiB, so we
# keep our floor above that. We never unload anyone else's model automatically.
TRELLIS_MIN_AVAILABLE_GB=45

# --- Generation defaults ---------------------------------------------------
TRELLIS_MODEL_REPO=microsoft/TRELLIS.2-4B
# One of: 512 | 1024 | 1024_cascade | 1536_cascade  (overridable per request)
TRELLIS_PIPELINE_TYPE=1024_cascade
ATTN_BACKEND=flash_attn

# --- Build / runtime -------------------------------------------------------
# Parallel nvcc jobs during the flash-attn build. Keep below the 20 host cores
# so the build does not starve ComfyUI / content-factory.
MAX_JOBS=4
# File ownership on the ./data and ./models bind mounts.
UID=1000
GID=1000
